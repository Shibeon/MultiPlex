{
  "name": "@multiplex/desktop",
  "version": "0.1.10",
  "private": true,
  "description": "Coque de bureau MultiPlex (Windows, macOS, Linux)",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "typecheck": "node --check main.cjs && node --check mpv.cjs && node --check updater.cjs && node --check preload.cjs && node --check display.cjs && node --check thumbs.cjs && node --check offline.cjs && node --check cast.cjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "author": {
    "name": "MultiPlex contributors",
    "email": "23738103+Shibeon@users.noreply.github.com"
  },
  "build": {
    "appId": "app.multiplex.client",
    "productName": "MultiPlex",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "mpv.cjs",
      "updater.cjs",
      "preload.cjs",
      "display.cjs",
      "thumbs.cjs",
      "offline.cjs",
      "cast.cjs",
      "display-mode.ps1",
      "mpv-input.conf",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../web/node_modules/@vladmandic/face-api/model",
        "to": "xray",
        "filter": [
          "ssd_mobilenetv1_model*",
          "face_landmark_68_model*",
          "face_recognition_model*"
        ]
      },
      {
        "from": "vendor/mpv",
        "to": "mpv",
        "filter": [
          "mpv.exe",
          "*.dll",
          "VERSION"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "executableName": "multiplex",
      "maintainer": "MultiPlex contributors <23738103+Shibeon@users.noreply.github.com>",
      "synopsis": "Client Plex communautaire"
    },
    "asarUnpack": [
      "mpv-input.conf",
      "display-mode.ps1"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Shibeon",
        "repo": "MultiPlex-releases",
        "releaseType": "release"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "homepage": "https://github.com/Shibeon/MultiPlex-releases"
}
