{
  "name": "@multiplex/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Coque de bureau MultiPlex (Windows, macOS, Linux)",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "typecheck": "node --check main.cjs && node --check mpv.cjs && node --check updater.cjs && node --check preload.cjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "author": "MultiPlex contributors",
  "build": {
    "appId": "app.multiplex.client",
    "productName": "MultiPlex",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "mpv.cjs",
      "updater.cjs",
      "preload.cjs",
      "mpv-input.conf",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "vendor/mpv",
        "to": "mpv",
        "filter": [
          "mpv.exe",
          "*.dll",
          "VERSION"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "asarUnpack": [
      "mpv-input.conf"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}
